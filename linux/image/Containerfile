# Herald OS Linux as a bootable container image (ADR-018): Fedora bootc with the Herald OS session,
# the CLIs and the prebuilt shell. Updates replace the whole image (bootc upgrade) and the previous
# one stays in the boot menu. Built by .github/workflows/image.yml; locally, from the repo root, with
# the shell tarball for the same architecture next to it:
#
#   podman build -f linux/image/Containerfile --build-arg SHELL_TARBALL=herald-os-linux.tar.gz -t herald-os .
FROM quay.io/fedora/fedora-bootc:44

ARG SHELL_TARBALL=herald-os-linux.tar.gz
COPY linux /tmp/herald-os/linux
COPY ${SHELL_TARBALL} /tmp/herald-os/shell.tar.gz
COPY upstream/hermes-agent /usr/lib/haos/hermes

RUN bash /tmp/herald-os/linux/image/packages.sh --image /tmp/herald-os/shell.tar.gz \
 && bash /tmp/herald-os/linux/haos/build-runtime.sh \
 && dnf clean all \
 && rm -rf /tmp/herald-os /var/cache/* /var/log/* /var/lib/dnf

LABEL org.opencontainers.image.title="HAOS" \
      org.opencontainers.image.description="Hermes Autonomous OS, based on Herald OS" \
      org.opencontainers.image.source="https://github.com/BlueDragon4251/HAOS" \
      org.opencontainers.image.licenses="MIT" \
      containers.bootc="1"

RUN bootc container lint
