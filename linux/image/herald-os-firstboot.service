[Unit]
Description=HAOS: initialize locked desktop observer and isolated Hermes runtime
# Once per machine. HAOS owner enrollment runs separately on tty2;
# this service never grants the graphical observer administrator authority.
ConditionPathExists=!/var/lib/herald-os/firstboot-done
Wants=network-online.target
After=network-online.target
Before=greetd.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/herald-os/firstboot.sh system
StandardOutput=journal+console
TimeoutStartSec=45min
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
