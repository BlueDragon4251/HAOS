OVERLAY = {"ask", "command", "applications", "menu", "power", "clipboard"}


# ---------------------------------------------------------------------------------------------
def die(message: str, code: int = 1) -> "None":
    print(f"herald-os: {message}", file=sys.stderr)
    sys.exit(code)


def sh(argv: list[str], *, timeout: float = 60, check: bool = False, input_: str | None = None, capture: bool = True) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(argv, capture_output=capture, text=True, timeout=timeout, check=check, input=input_)
    except FileNotFoundError:
        die(f"{argv[0]} is not installed", 127)
    except subprocess.TimeoutExpired:
        die(f"{argv[0]} timed out after {timeout:.0f}s", 124)
    return subprocess.CompletedProcess(argv, 1)  # unreachable, keeps type checkers calm


def relay(cmd: str, args: list[str], extra: dict | None = None, *, quiet: bool = False) -> dict:
    """Send one JSON line to the shell and return its JSON reply."""
    if not SOCKET.exists():
        if quiet:
            return {"ok": False, "error": "shell not running"}
        die(f"the Herald OS shell is not running (no {SOCKET})", 3)
    payload = {"cmd": cmd, "args": args, **(extra or {})}
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(15)
            s.connect(str(SOCKET))
            s.sendall((json.dumps(payload) + "\n").encode())
            buf = b""
            while not buf.endswith(b"\n"):
                chunk = s.recv(65536)
                if not chunk:
                    break
                buf += chunk
    except OSError as exc:
        if quiet:
            return {"ok": False, "error": str(exc)}
        die(f"cannot talk to the shell: {exc}", 3)
    try:
        return json.loads(buf.decode() or "{}")
    except json.JSONDecodeError:
        return {"ok": False, "error": f"bad reply: {buf[:200]!r}"}


def notify(title: str, body: str = "") -> None:
    """Notification through the shell; falls back to notify-send when the shell is down."""
    reply = relay("notify", [title, body], quiet=True)
    if not reply.get("ok") and shutil.which("notify-send"):
        subprocess.run(["notify-send", title, body], check=False)


def niri(*action: str) -> int:
    if not shutil.which("niri"):
        die("niri is not installed", 2)
    return subprocess.call(["niri", "msg", "action", *action])


def slugify(name: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-") or "webapp"


# ---------------------------------------------------------------------------------------------
# Software.
def looks_like_flatpak_id(name: str) -> bool:
    return name.count(".") >= 2 and " " not in name


def flatpak_ready() -> bool:
    if not shutil.which("flatpak"):
        return False
    remotes = sh(["flatpak", "remotes", "--columns=name"], timeout=20).stdout.split()
    if "flathub" not in remotes:
        sh(["flatpak", "remote-add", "--user", "--if-not-exists", "flathub", "https://dl.flathub.org/repo/flathub.flatpakrepo"], timeout=120)
    return True


def flatpak_search(name: str) -> list[tuple[str, str]]:
    """Flathub matches for a human name, as (app id, name) pairs."""
    if not flatpak_ready():
        return []
    result = sh(["flatpak", "search", "--columns=application,name", name], timeout=120)
    rows = [line.split("\t") for line in result.stdout.splitlines() if "\t" in line]
    return [(row[0].strip(), row[1].strip()) for row in rows]


def flatpak_resolve(name: str) -> str:
    """The Flathub app id a name clearly means: an exact name match or the only result. A loose search
    also returns themes and plugins ("obsidian" lists GTK themes first), so anything else is refused
    with the candidates, for the caller to pick one by id."""
    if looks_like_flatpak_id(name):
        return name
    matches = flatpak_search(name)
    exact = [app_id for app_id, app_name in matches if app_name.lower() == name.lower()]
    if exact:
        return exact[0]
    if len(matches) == 1:
        return matches[0][0]
    if not matches:
        die(f"no package or Flatpak found for {name!r}", 1)
    options = ", ".join(f"{app_name} ({app_id})" for app_id, app_name in matches[:5])
    die(f"{name!r} matches several Flatpaks; install one by id: {options}", 1)


def rpm_available(name: str) -> bool:
    if not shutil.which("dnf"):
        return False
    return sh(["dnf", "-q", "list", "--available", name], timeout=180).returncode == 0


def install_app(name: str) -> int:
    if not name:
        die("install app needs a name", 2)
    if not looks_like_flatpak_id(name) and rpm_available(name):
        print(f"==> dnf install {name}")
        code = subprocess.call(["sudo", "-n", "dnf", "-y", "install", name])
        notify("Installed" if code == 0 else "Install failed", name)
        return code
    app_id = flatpak_resolve(name)
    print(f"==> flatpak install {app_id}")
    code = subprocess.call(["flatpak", "install", "-y", "--noninteractive", "--user", "flathub", app_id])
    notify("Installed" if code == 0 else "Install failed", app_id)
    return code


def remove_app(name: str) -> int:
    if not name:
        die("remove app needs a name", 2)
    if sh(["rpm", "-q", name], timeout=30).returncode == 0:
        code = subprocess.call(["sudo", "-n", "dnf", "-y", "remove", name])
    else:
        app_id = name if looks_like_flatpak_id(name) else None
        if app_id is None and shutil.which("flatpak"):
            for line in sh(["flatpak", "list", "--app", "--columns=application,name"], timeout=60).stdout.splitlines():
                parts = line.split("\t")
                if len(parts) == 2 and parts[1].strip().lower() == name.lower():
                    app_id = parts[0].strip()
        if not app_id:
            die(f"{name!r} is not an installed package or Flatpak", 1)
        code = subprocess.call(["flatpak", "uninstall", "-y", "--noninteractive", app_id])
    notify("Removed" if code == 0 else "Remove failed", name)
    return code


def install_webapp(name: str, url: str, icon_url: str | None = None) -> int:
    if not name or not url.startswith(("http://", "https://")):
        die("install webapp needs a name and an http(s) url", 2)
    slug = slugify(name)
    APPS_DIR.mkdir(parents=True, exist_ok=True)
    ICONS_DIR.mkdir(parents=True, exist_ok=True)
    icon_path = ICONS_DIR / f"{slug}.png"
    host = urllib.parse.urlparse(url).netloc
    for candidate in filter(None, [icon_url, f"https://www.google.com/s2/favicons?domain={host}&sz=256"]):
        if sh(["curl", "-fsSL", "--max-time", "20", "-o", str(icon_path), candidate], timeout=30).returncode == 0 and icon_path.stat().st_size > 0:
            break
    else:
        icon_path = Path("web-browser")
    desktop = APPS_DIR / f"hermes-webapp-{slug}.desktop"
    desktop.write_text(
        "[Desktop Entry]\n"
        f"Name={name}\n"
        f"Comment=Herald OS web app for {host}\n"
        f"Exec=herald-os webapp-open {shell_quote(url)} {shell_quote(name)}\n"
        f"Icon={icon_path}\n"
        "Type=Application\n"
        "Categories=Network;WebApp;\n"
        f"StartupWMClass=hermes-webapp-{slug}\n"
        "Terminal=false\n"
    )
    if shutil.which("update-desktop-database"):
        subprocess.run(["update-desktop-database", str(APPS_DIR)], check=False, capture_output=True)
    notify("Web app added", f"{name} is in Applications")
    print(str(desktop))
    return 0


def shell_quote(value: str) -> str:
    return '"' + value.replace('"', '\\"') + '"'


def remove_webapp(name: str) -> int:
    slug = slugify(name)
    removed = False
    for path in (APPS_DIR / f"hermes-webapp-{slug}.desktop", ICONS_DIR / f"{slug}.png"):
        if path.exists():
            path.unlink()
            removed = True
    if not removed:
        die(f"no web app named {name!r}", 1)
    notify("Web app removed", name)
    return 0


def webapp_open(url: str, name: str) -> int:
    reply = relay("webapp", [url, name, slugify(name)])
    if not reply.get("ok"):
        # Shell not running: fall back to the browser.
        return subprocess.call(["xdg-open", url])
    return 0


# ---------------------------------------------------------------------------------------------
# Style. The theme engine itself lives in Phase 3; this is its stable CLI.
def theme_dirs() -> list[Path]:
    return [d for d in THEME_DIRS if d.is_dir()]


def theme_list() -> int:
    seen: set[str] = set()
    for base in theme_dirs():
        for entry in sorted(base.iterdir()):
            if entry.is_dir() and (entry / "theme.json").exists() and entry.name not in seen:
                seen.add(entry.name)
                print(entry.name)
    if not seen:
        print("herald-ocean")
    return 0


def theme_current() -> int:
    marker = CONFIG_DIR / "theme"
    print(marker.read_text().strip() if marker.exists() else "herald-ocean")
    return 0


def theme_set(name: str) -> int:
    if not name:
        die("theme set needs a name", 2)
    applier = shutil.which("herald-os-theme")
    if applier:
        return subprocess.call([applier, "set", name])
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    (CONFIG_DIR / "theme").write_text(name + "\n")
    relay("theme", [name], quiet=True)
    return 0


THEME_COLOR_KEYS = ("bg", "bg2", "surface", "fg", "fg_dim", "accent", "accent_strong", "border_active", "border_inactive", "urgent", "ok", "warn")
HEX_COLOR = re.compile(r"^#[0-9a-fA-F]{6}$")
THEME_NAME = re.compile(r"^[a-z0-9][a-z0-9-]{0,39}$")
IMAGE_EXTENSIONS = {".png", ".jpg", ".jpeg", ".webp", ".avif"}
MAX_THEME_IMAGE = 25 * 1024 * 1024


def theme_problem(spec: object) -> str | None:
    if not isinstance(spec, dict):
        return "theme.json must be a JSON object"
    if not THEME_NAME.match(str(spec.get("name") or "")):
        return 'theme.json needs a "name" of lowercase letters, digits and dashes'
    colors = spec.get("colors")
    if not isinstance(colors, dict):
        return 'theme.json needs "colors"'
    bad = [key for key in THEME_COLOR_KEYS if not HEX_COLOR.match(str(colors.get(key) or ""))]
    return f"theme.json colours must be #rrggbb; check {', '.join(bad)}" if bad else None


def theme_install(url: str) -> int:
    """Install the themes in a git repository, keeping only colours and images: a theme cannot run code."""
    if not re.match(r"^https://[\w.-]+/[\w./-]+$", url):
        die("theme install needs the https address of a git repository", 2)
    if not shutil.which("git"):
        die("git is not installed", 127)
    user_dir = CONFIG_DIR / "themes"
    builtin_dirs = [d for d in THEME_DIRS if d != user_dir]
    installed: list[str] = []
    with tempfile.TemporaryDirectory(prefix="herald-theme-") as scratch:
        result = sh(["git", "clone", "--depth", "1", "--quiet", url, scratch], timeout=180)
        if result.returncode != 0:
            die(result.stderr.strip() or "git clone failed", 1)
        root = Path(scratch)
        folders = [root] if (root / "theme.json").exists() else [d for d in sorted(root.iterdir()) if d.is_dir() and not d.name.startswith(".") and (d / "theme.json").exists()]
        if not folders:
            die("the repository has no theme.json", 1)
        for folder in folders:
            try:
                spec = json.loads((folder / "theme.json").read_text())
            except json.JSONDecodeError as exc:
                die(f"{folder.name}: theme.json is not valid JSON ({exc})", 1)
            problem = theme_problem(spec)
            if problem:
                die(f"{folder.name}: {problem}", 1)
            name = spec["name"]
            if any((base / name / "theme.json").exists() for base in builtin_dirs):
                die(f"{name!r} is a built-in theme name", 1)
            target = user_dir / name
            shutil.rmtree(target, ignore_errors=True)
            target.mkdir(parents=True)
            for entry in folder.iterdir():
                if entry.is_file() and not entry.is_symlink() and entry.suffix.lower() in IMAGE_EXTENSIONS and entry.stat().st_size <= MAX_THEME_IMAGE:
                    shutil.copy2(entry, target / entry.name)
            wallpaper_name = Path(str(spec.get("wallpaper") or "default")).name
            clean = {key: spec[key] for key in ("name", "label", "description", "colors", "gtk", "terminal") if key in spec}
            clean["wallpaper"] = wallpaper_name if (target / wallpaper_name).is_file() else "default"
            scheme = (spec.get("shell") or {}).get("scheme") if isinstance(spec.get("shell"), dict) else None
            if scheme in ("dark", "light"):
                clean["shell"] = {"scheme": scheme}
            (target / "theme.json").write_text(json.dumps(clean, indent=2) + "\n")
            installed.append(name)
    notify("Themes installed", ", ".join(installed))
    print("\n".join(installed))
    return 0


def font(args: list[str]) -> int:
    sub = args[0] if args else "list"
    if sub == "list":
        if not shutil.which("fc-list"):
            die("fc-list is not installed (fontconfig)", 127)
        families = sorted({line.split(",")[0].strip() for line in sh(["fc-list", ":", "family"], timeout=30).stdout.splitlines() if line.strip()})
        print("\n".join(families))
        return 0
    if sub == "set":
        mono = "--mono" in args
        family = " ".join(a for a in args[1:] if a != "--mono").strip()
        if not family:
            die("font set <family> [--mono]  (default puts the built-in font back)", 2)
        reset = family.lower() in ("default", "reset", "system")
        if mono:
            # The foot rescue terminal follows the code font; the theme engine reads this file.
            marker = CONFIG_DIR / "font-mono"
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            if reset:
                marker.unlink(missing_ok=True)
            else:
                marker.write_text(family + "\n")
            if shutil.which("herald-os-theme"):
                subprocess.run(["herald-os-theme", "set", theme_name_current()], check=False, capture_output=True)
        return run_os("font.set", {"family": family, "kind": "mono" if mono else "ui"})
    die("font list | font set <family> [--mono]", 2)
    return 2


def theme_name_current() -> str:
    marker = CONFIG_DIR / "theme"
    return marker.read_text().strip() if marker.exists() else "herald-ocean"


def wallpaper(path: str) -> int:
    value = "" if path in ("default", "") else str(Path(path).expanduser().resolve())
    if value and not Path(value).is_file():
        die(f"no such image: {path}", 1)
    reply = relay("wallpaper", [value])
    return 0 if reply.get("ok") else 1


# ---------------------------------------------------------------------------------------------
# Trigger.
DURATION_RE = re.compile(r"^(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?$")


def parse_duration(text: str) -> int:
    if text.isdigit():
        return int(text) * 60
    match = DURATION_RE.match(text)
    if not match or not any(match.groups()):
        die(f"bad duration {text!r} (use 20m, 1h30m, 90s or plain minutes)", 2)
    h, m, s = (int(x) if x else 0 for x in match.groups())
    return h * 3600 + m * 60 + s


def reminder(args: list[str]) -> int:
    if not args or args[0] == "list":
        result = sh(["systemctl", "--user", "list-timers", "--all", "--no-pager", "--output=json", "hermes-reminder-*"], timeout=15)
        try:
            timers = json.loads(result.stdout or "[]")
        except json.JSONDecodeError:
            timers = []
        if not timers:
            print("No reminders set.")
            return 0
        for timer in sorted(timers, key=lambda t: t.get("next") or 0):
            desc = sh(["systemctl", "--user", "show", "-p", "Description", "--value", timer["unit"]], timeout=10).stdout.strip()
            when = datetime.fromtimestamp(timer["next"] / 1_000_000).strftime("%a %H:%M") if timer.get("next") else "now"
            print(f"{when:<9} {desc.removeprefix('Reminder: ')}")
        return 0
    if args[0] == "clear":
        result = sh(["systemctl", "--user", "list-units", "--all", "--no-legend", "--no-pager", "hermes-reminder-*"], timeout=15)
        units = [tok for line in result.stdout.splitlines() for tok in line.split() if tok.startswith("hermes-reminder-")]
        for unit in units:
            subprocess.run(["systemctl", "--user", "stop", unit], check=False, capture_output=True)
        notify("Reminders cleared", f"{len(units)} cancelled" if units else "None were set")
        return 0
    if len(args) < 2:
        die("reminder <duration> <message>", 2)
    seconds = parse_duration(args[0])
    message = " ".join(args[1:])
    unit = f"hermes-reminder-{time.time_ns()}"
    result = sh([
        "systemd-run", "--user", "--quiet", f"--on-active={seconds}", f"--unit={unit}",
        f"--description=Reminder: {message}", "--timer-property=AccuracySec=1s",
        "herald-os", "notify", "Reminder", message,
    ], timeout=15)
    if result.returncode != 0:
        die(result.stderr.strip() or "systemd-run failed", 1)
    when = datetime.fromtimestamp(time.time() + seconds).strftime("%H:%M")
    notify("Reminder set", f"{message} at {when}")
    print(f"{unit} fires at {when}")
    return 0


def notice(kind: str) -> int:
    if kind == "time":
        now = datetime.now()
        notify(now.strftime("%A, %-d %B"), now.strftime("%H:%M"))
    elif kind == "battery":
        bats = sorted(Path("/sys/class/power_supply").glob("BAT*"))
        if not bats:
            notify("Battery", "No battery in this machine")
        else:
            cap = (bats[0] / "capacity").read_text().strip()
            status = (bats[0] / "status").read_text().strip()
            notify(f"Battery {cap}%", status)
    elif kind == "weather":
        result = sh(["curl", "-fsS", "--max-time", "8", "https://wttr.in/?format=%l:+%c+%t+(%C),+wind+%w"], timeout=12)
        notify("Weather", result.stdout.strip() if result.returncode == 0 else "Weather is unavailable right now")
    else:
        die("notice time|battery|weather", 2)
    return 0


def screenshot() -> int:
    out_dir = HOME / "Pictures" / "Screenshots"
    out_dir.mkdir(parents=True, exist_ok=True)
    path = out_dir / f"Screenshot {datetime.now():%Y-%m-%d %H-%M-%S}.png"
    code = subprocess.call(["grim", str(path)]) if shutil.which("grim") else niri("screenshot-screen")
    if code != 0 or not path.exists():
        die("screenshot failed", code or 1)
    reply = relay("ask", ["Here is a screenshot I just took. What do you see?"], {"attachments": [str(path)]}, quiet=True)
    if not reply.get("ok"):
        print(str(path))
    return 0


CAPTURES = Path(tempfile.gettempdir()) / "herald-os-captures"


def capture(args: list[str]) -> int:
    sub = args[0] if args else ""
    if sub == "region":
        for tool in ("grim", "slurp"):
            if not shutil.which(tool):
                die(f"{tool} is not installed (dnf install grim slurp)", 127)
        region = sh(["slurp"], timeout=300)
        if region.returncode != 0 or not region.stdout.strip():
            return 1
        ask = "--ask" in args
        out_dir = CAPTURES if ask else HOME / "Pictures" / "Screenshots"
        out_dir.mkdir(parents=True, exist_ok=True)
        path = out_dir / f"Screenshot {datetime.now():%Y-%m-%d %H-%M-%S}.png"
        if subprocess.call(["grim", "-g", region.stdout.strip(), str(path)]) != 0 or not path.exists():
            die("the screenshot failed", 1)
        if ask:
            # The command overlay opens with the picture attached; the person types the question.
            reply = relay("ask", [], {"attachments": [str(path)]}, quiet=True)
            if not reply.get("ok"):
                print(str(path))
            return 0
        print(str(path))
        return 0
    die("capture region [--ask]", 2)
    return 2


def ocr() -> int:
    for tool in ("grim", "slurp", "tesseract", "wl-copy"):
        if not shutil.which(tool):
            die(f"{tool} is not installed (dnf install grim slurp tesseract tesseract-langpack-eng wl-clipboard)", 127)
    region = sh(["slurp"], timeout=120)
    if region.returncode != 0 or not region.stdout.strip():
        return 1
    grab = subprocess.run(["grim", "-g", region.stdout.strip(), "-"], capture_output=True, timeout=30)
    text = subprocess.run(["tesseract", "stdin", "stdout", "--psm", "6"], input=grab.stdout, capture_output=True, timeout=60).stdout.decode().strip()
    if not text:
        notify("No text found", "The selection had no readable text")
        return 1
    subprocess.run(["wl-copy"], input=text.encode(), check=False)
    preview = text.replace("\n", " ")
    notify("Text copied", preview[:120] + ("…" if len(preview) > 120 else ""))
    print(text)
    return 0


# ---------------------------------------------------------------------------------------------
# Events and hooks: scripts in ~/.config/herald-os/hooks/<event>.d/ run when the event happens.
EVENT_NAMES = ("login", "wake", "sleep", "lock", "unlock", "returned", "battery-low", "network-change", "theme-set", "crash", "after-update")
HOOKS_DIR = CONFIG_DIR / "hooks"
HOOK_TIMEOUT = 120


def hook_scripts(event_name: str) -> list[Path]:
    folder = HOOKS_DIR / f"{event_name}.d"
    if not folder.is_dir():
        return []
    return [p for p in sorted(folder.iterdir()) if p.is_file() and os.access(p, os.X_OK) and not p.name.startswith(".") and not p.name.endswith((".sample", "~"))]


def run_hooks_here(event_name: str, detail: dict[str, str]) -> None:
    """The shell runs hooks itself; without it (a TTY, an update before login) they run from here."""
    env = {**os.environ, "HERALD_EVENT": event_name, "HERALD_EVENT_AT": datetime.now().astimezone().isoformat(),
           "HERALD_EVENT_JSON": json.dumps({"name": event_name, "detail": detail})}
    env.update({f"HERALD_EVENT_{re.sub(r'[^A-Z0-9]+', '_', key.upper())}": value for key, value in detail.items()})
    for script in hook_scripts(event_name):
        try:
            subprocess.run([str(script), event_name], env=env, timeout=HOOK_TIMEOUT, check=False)
        except (OSError, subprocess.TimeoutExpired) as exc:
            print(f"herald-os: hook {script.name}: {exc}", file=sys.stderr)


def event_cmd(args: list[str]) -> int:
    if not args or args[0] not in EVENT_NAMES:
        die(f"event <name> [key=value ...]; names: {', '.join(EVENT_NAMES)}", 2)
    name, pairs = args[0], args[1:]
    reply = relay("event", [name, *pairs], quiet=True)
    if not reply.get("ok"):
        run_hooks_here(name, dict(pair.split("=", 1) for pair in pairs if "=" in pair))
    return 0


def hook_cmd(args: list[str]) -> int:
    sub = args[0] if args else "list"
    if sub == "dir":
        print(HOOKS_DIR)
        return 0
    if sub == "list":
        for name in EVENT_NAMES:
            scripts = hook_scripts(name)
            print(f"{name:<15} {', '.join(s.name for s in scripts) if scripts else '-'}")
        return 0
    if sub == "install" and len(args) == 3:
        name, source = args[1], Path(args[2]).expanduser()
        if name not in EVENT_NAMES:
            die(f"no event called {name!r}; events: {', '.join(EVENT_NAMES)}", 2)
        if not source.is_file():
            die(f"no such script: {args[2]}", 1)
        target = HOOKS_DIR / f"{name}.d" / source.name
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, target)
        target.chmod(target.stat().st_mode | 0o755)
        print(f"installed {target}")
        return 0
    die("hook list | hook install <event> <script> | hook dir", 2)
    return 2


# ---------------------------------------------------------------------------------------------
# Crashes: core dumps from systemd-coredump; the shell turns a diagnosis into a Hermes chat.
def run_os(command: str, args: dict | None = None) -> int:
    """Run a registry command in the Hermes window (fire and forget; the shell reports the result)."""
    reply = relay("os", [command, json.dumps(args or {})])
    if not reply.get("ok"):
        die(reply.get("error") or f"the shell rejected {command}", 1)
    return 0


def signal_name(number: object) -> str:
    try:
        return signal.Signals(int(number)).name  # type: ignore[arg-type]
    except (TypeError, ValueError):
        return str(number or "?")


def coredumps() -> list[dict]:
    if not shutil.which("coredumpctl"):
        die("coredumpctl is not installed (it ships with systemd-coredump)", 127)
    result = sh(["coredumpctl", "list", "--json=short", "--no-pager", "--since=-7d"], timeout=30)
    try:
        rows = json.loads(result.stdout or "[]")
    except json.JSONDecodeError:
        rows = []
    return sorted((r for r in rows if isinstance(r, dict)), key=lambda r: r.get("time") or 0, reverse=True)


def crash(args: list[str]) -> int:
    sub = args[0] if args else "list"
    if sub == "list":
        rows = coredumps()
        if not rows:
            print("No crashes in the last 7 days.")
            return 0
        for row in rows[:30]:
            when = datetime.fromtimestamp(row["time"] / 1_000_000).strftime("%a %d %b %H:%M") if row.get("time") else "?"
            print(f"{when:<16} {str(row.get('pid', '?')):>7}  {Path(str(row.get('exe') or '?')).name:<24} {signal_name(row.get('sig'))}")
        return 0
    if sub == "diagnose":
        target = " ".join(args[1:]).strip()
        if not target.isdigit():
            return run_os("crash.diagnose", {"crash": target} if target else {})
        row = next((r for r in coredumps() if str(r.get("pid")) == target), None)
        details: dict = {"pid": int(target)}
        if row:
            details["app"] = Path(str(row.get("exe") or "")).name or None
            details["reason"] = signal_name(row.get("sig"))
            if row.get("time"):
                details["at"] = datetime.fromtimestamp(row["time"] / 1_000_000).astimezone().isoformat()
        return run_os("crash.diagnose", {k: v for k, v in details.items() if v})
    if sub == "mute":
        off = len(args) > 2 and args[-1] == "off"
        name = " ".join(args[1:-1] if off else args[1:]).strip()
        if not name:
            die("crash mute <name> [off]", 2)
        return run_os("crash.mute", {"app": name, "muted": not off})
    die("crash list | crash diagnose [pid|name] | crash mute <name> [off]", 2)
    return 2


# ---------------------------------------------------------------------------------------------
# System.
def account_has_password() -> bool | None:
    """True/False when it can be determined (needs passwordless sudo for `passwd -S`), else None."""
    result = subprocess.run(["sudo", "-n", "passwd", "-S", os.environ.get("USER") or Path.home().name], capture_output=True, text=True)
    if result.returncode != 0:
        return None
    fields = result.stdout.split()
    return len(fields) > 1 and fields[1] == "P"


def lock() -> int:
    # A lock nobody can undo is worse than no lock: an account without a password (the default in
    # the dev VM) would leave the compositor's session lock engaged with no way back in.
    if account_has_password() is False:
        notify("Lock skipped", "Set a password first: herald-os password")
        return 1
    if shutil.which("swaylock"):
        cfg = HOME / ".config" / "swaylock" / "config"
        args = ["swaylock", "-f"] + (["-C", str(cfg)] if cfg.exists() else ["--color", "04113f"])
        return subprocess.call(args)
    return subprocess.call(["loginctl", "lock-session"])


def password() -> int:
    """Set (or change) the login password used by the lock screen; interactive by design."""
    if not sys.stdin.isatty():
        die("run `herald-os password` in a terminal", 2)
    return subprocess.call(["passwd"])


def suspend() -> int:
    lock()
    return subprocess.call(["systemctl", "suspend"])


def update(check_only: bool) -> int:
    updater = shutil.which("herald-os-update")
    if updater:
        return subprocess.call([updater] + (["--check"] if check_only else []))
    print("herald-os-update is not installed; run linux/dev/build.sh in your Herald-OS checkout to install it.")
    return 1


def debug() -> int:
    def line(label: str, argv: list[str]) -> None:
        try:
            out = subprocess.run(argv, capture_output=True, text=True, timeout=5).stdout.strip().splitlines()
            print(f"{label:<14} {out[0] if out else '-'}")
        except Exception:  # noqa: BLE001
            print(f"{label:<14} unavailable")

    print("Herald OS debug")
    line("os", ["sh", "-c", ". /etc/os-release && echo $PRETTY_NAME"])
    line("kernel", ["uname", "-r"])
    line("niri", ["niri", "--version"])
    line("cage", ["cage", "-h"])
    line("electron", ["sh", "-c", "pgrep -a electron | head -1"])
    line("hermes", ["sh", "-c", f"{HOME}/.hermes/hermes-agent/venv/bin/hermes --version 2>/dev/null || echo missing"])
    print(f"{'shell socket':<14} {'up' if SOCKET.exists() else 'down'} ({SOCKET})")
    print(f"{'compositor':<14} {os.environ.get('HERALD_OS_COMPOSITOR', 'niri')} nested={os.environ.get('HERALD_OS_NIRI_NESTED', 'auto')}")
    for name in ("shell.log", "compositor.log"):
        path = STATE_DIR / name
        if path.exists():
            print(f"--- {name} (tail)")
            print("\n".join(path.read_text(errors="replace").splitlines()[-8:]))
    return 0


# ---------------------------------------------------------------------------------------------
def main(argv: list[str]) -> int:
    if not argv or argv[0] in {"-h", "--help", "help"}:
        print(__doc__.strip())
        return 0
    cmd, args = argv[0], argv[1:]
    if cmd == "commands":
        if "--json" in args:
            print(json.dumps([{"name": k, "help": v} for k, v in COMMANDS.items()], indent=2))
        else:
            width = max(len(k) for k in COMMANDS)
            for name, text in COMMANDS.items():
                print(f"  {name.ljust(width)}  {text}")
        return 0
    if cmd not in COMMANDS:
        die(f"unknown command {cmd!r} (see `herald-os commands`)", 2)

    if cmd == "channel":
        marker = CONFIG_DIR / "channel"
        if args:
            if args[0] not in ("stable", "edge"):
                die("channel stable|edge", 2)
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            marker.write_text(args[0] + "\n")
        print(marker.read_text().strip() if marker.exists() else "stable")
        return 0
    if cmd == "omakase":
        tool = shutil.which("herald-os-omakase")
        if not tool:
            die("herald-os-omakase is not installed", 127)
        return subprocess.call([tool, *(args or ["install"])])
    if cmd in OVERLAY or cmd in {"page", "open", "launch", "notify", "voice", "state", "update-available"}:
        reply = relay(cmd, args)
        if cmd == "state":
            print(json.dumps(reply, indent=2))
        if not reply.get("ok", False):
            die(reply.get("error") or "the shell rejected the command", 1)
        return 0
    if cmd == "install":
        if len(args) >= 2 and args[0] == "app":
            return install_app(" ".join(args[1:]))
        if len(args) >= 3 and args[0] == "webapp":
            return install_webapp(args[1], args[2], args[3] if len(args) > 3 else None)
        die("install app <name> | install webapp <name> <url> [icon-url]", 2)
    if cmd == "remove":
        if len(args) >= 2 and args[0] == "app":
            return remove_app(" ".join(args[1:]))
        if len(args) >= 2 and args[0] == "webapp":
            return remove_webapp(" ".join(args[1:]))
        die("remove app <name> | remove webapp <name>", 2)
    if cmd == "webapp-open":
        if len(args) < 2:
            die("webapp-open <url> <name>", 2)
        return webapp_open(args[0], " ".join(args[1:]))
    if cmd == "update":
        return update("--check" in args)
    if cmd == "theme":
        sub = args[0] if args else "current"
        if sub == "list":
            return theme_list()
        if sub == "current":
            return theme_current()
        if sub == "set":
            return theme_set(" ".join(args[1:]))
        if sub == "install" and len(args) == 2:
            return theme_install(args[1])
        if sub == "new" and len(args) >= 2:
            image = Path(args[1]).expanduser().resolve()
            if not image.is_file():
                die(f"no such image: {args[1]}", 1)
            return run_os("theme.generate", {"image": str(image), **({"name": " ".join(args[2:])} if len(args) > 2 else {})})
        die("theme list | theme set <name> | theme current | theme new <image> [name] | theme install <git-url>", 2)
    if cmd == "font":
        return font(args)
    if cmd == "wallpaper":
        return wallpaper(args[0] if args else "default")
    if cmd == "reminder":
        return reminder(args)
    if cmd == "notice":
        return notice(args[0] if args else "")
    if cmd == "screenshot":
        return screenshot()
    if cmd == "capture":
        return capture(args)
    if cmd == "ocr":
        return ocr()
    if cmd == "crash":
        return crash(args)
    if cmd == "event":
        return event_cmd(args)
    if cmd == "hook":
        return hook_cmd(args)
    if cmd == "os":
        if not args:
            die("os <command.id> [json args]", 2)
        try:
            payload = json.loads(args[1]) if len(args) > 1 else {}
        except json.JSONDecodeError:
            die("os: the arguments must be a JSON object", 2)
        return run_os(args[0], payload if isinstance(payload, dict) else {})
    if cmd == "lock":
        return lock()
    if cmd == "password":
        return password()
    if cmd == "suspend":
        return suspend()
    if cmd == "wm":
        if not args:
            die("wm needs a niri action", 2)
        return niri(*args)
    if cmd == "debug":
        return debug()
    die(f"{cmd} is not implemented", 2)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
