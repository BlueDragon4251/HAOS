#!/usr/bin/env python3
"""Herald OS command center.

Everything hotkeys and menus do is available here, so people and agents drive the system the same
way. Shell-facing commands are relayed to the running shell over its control socket; system chores
call the tools directly.

  Hermes        ask [text] | command | applications | menu | page <id> | open <window> | launch <app>
  Software      install app <name|flatpak-id> | install webapp <name> <url> [icon-url]
                remove app <name> | remove webapp <name> | update [--check]
  Style         theme list | theme set <name> | theme current | theme new <image> [name]
                theme install <git-url> | font list | font set <family> [--mono] | wallpaper <image>
  Trigger       reminder <duration> <message> | reminder list | reminder clear
                notice time|battery|weather | screenshot | ocr | clipboard | notify <title> [body]
  Crashes       crash list | crash diagnose [pid|name] | crash mute <name> [off]
  Events        event <name> [key=value ...] | hook list | hook install <event> <script> | hook dir
  System        lock | suspend | power | wm <niri action...> | state | debug | commands [--json]
                os <command.id> [json args]: run any Herald OS command (the same ones Hermes uses)
"""

from __future__ import annotations

import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time
import urllib.parse
from datetime import datetime
from pathlib import Path

HOME = Path.home()
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}")
SOCKET = RUNTIME / "herald-os" / "control.sock"
STATE_DIR = HOME / ".local" / "state" / "herald-os"
CONFIG_DIR = HOME / ".config" / "herald-os"
APPS_DIR = HOME / ".local" / "share" / "applications"
ICONS_DIR = HOME / ".local" / "share" / "icons" / "hermes-webapps"
THEME_DIRS = [HOME / "Herald-OS" / "linux" / "themes", Path("/usr/local/share/herald-os-linux/themes"), HOME / ".config" / "herald-os" / "themes"]

# name -> help
