#!/usr/bin/env bash
# Update Herald OS: the shell (repo + rebuild), one-shot migrations, Fedora packages, Flatpaks and
# Hermes Agent. `--check` only reports and records whether anything is pending (the menu bar shows a
# dot). Channels (~/.config/herald-os/channel): stable (default) or edge; both track the repo's main
# branch until releases are cut, and are recorded so that switching later is a one-line change.
#
#   herald-os-update [--check] [--migrate] [--no-system] [--no-hermes]
#
# `--migrate` only runs pending one-shot migrations (linux/dev/build.sh calls it after every build).
set -uo pipefail

REPO="${HERALD_OS_REPO:-$HOME/Herald-OS}"
STATE="$HOME/.local/state/herald-os"
CONFIG="$HOME/.config/herald-os"
CHANNEL="$(cat "$CONFIG/channel" 2>/dev/null || echo stable)"
MIGRATIONS_DONE="/var/lib/herald-os/migrations"
CHECK=0
MIGRATE=0
SYSTEM=1
HERMES=1
for arg in "$@"; do
  case "$arg" in
    --check) CHECK=1 ;;
    --migrate) MIGRATE=1 ;;
    --no-system) SYSTEM=0 ;;
    --no-hermes) HERMES=0 ;;
    *) echo "unknown option $arg" >&2; exit 2 ;;
  esac
done
mkdir -p "$STATE" "$CONFIG"

branch_for_channel() {
  case "$CHANNEL" in
    edge) echo main ;;
    *) echo main ;;
  esac
}

notify() { herald-os notify "$1" "${2:-}" >/dev/null 2>&1 || true; }
report() { herald-os update-available "$1" "$2" >/dev/null 2>&1 || true; }

# One-shot migrations, tracked by file name so each runs exactly once per machine. Appends failures
# to `failed`.
failed=()
run_migrations() {
  [[ -d "$REPO/linux/migrations" ]] || return 0
  sudo -n mkdir -p "$MIGRATIONS_DONE"
  local migration name
  for migration in "$REPO"/linux/migrations/*.sh; do
    [[ -f "$migration" ]] || continue
    name="$(basename "$migration")"
    [[ -f "$MIGRATIONS_DONE/$name" ]] && continue
    echo "==> migration $name"
    if REPO="$REPO" bash "$migration"; then
      sudo -n touch "$MIGRATIONS_DONE/$name"
    else
      failed+=("migration:$name")
    fi
  done
}

if [[ $MIGRATE -eq 1 ]]; then
  run_migrations
  [[ ${#failed[@]} -eq 0 ]] || { echo "failed: ${failed[*]}" >&2; exit 1; }
  exit 0
fi

# ---------------------------------------------------------------------------------------------
pending_repo=0
repo_remote=""
if [[ -d "$REPO/.git" ]]; then
  branch="$(branch_for_channel)"
  if git -C "$REPO" remote get-url origin >/dev/null 2>&1; then
    repo_remote="origin/$branch"
    git -C "$REPO" fetch --quiet origin "$branch" 2>/dev/null || echo "WARNING: could not fetch $repo_remote"
    ahead="$(git -C "$REPO" rev-list --count "HEAD..$repo_remote" 2>/dev/null || echo 0)"
    [[ "$ahead" -gt 0 ]] && pending_repo=$ahead
  fi
else
  echo "repo at $REPO has no .git (pushed from a Mac): shell updates arrive with linux/dev/push.sh"
fi

pending_pkgs=0
if [[ $SYSTEM -eq 1 ]] && command -v dnf >/dev/null; then
  # check-update exits 100 when updates exist.
  out="$(dnf -q check-update 2>/dev/null)"
  rc=$?
  if [[ $rc -eq 100 ]]; then
    pending_pkgs="$(echo "$out" | grep -cE '^[[:alnum:]]')"
  fi
fi

pending_flatpaks=0
if [[ $SYSTEM -eq 1 ]] && command -v flatpak >/dev/null; then
  pending_flatpaks="$(flatpak remote-ls --user --updates --columns=application flathub 2>/dev/null | grep -c . || true)"
fi

plural() { [[ $1 -eq 1 ]] && echo "$1 $2" || echo "$1 ${2}s"; }

if [[ $CHECK -eq 1 ]]; then
  total=$((pending_repo + pending_pkgs + pending_flatpaks))
  # What the menu bar shows, e.g. "Herald OS, 192 packages, 3 apps".
  parts=()
  [[ $pending_repo -gt 0 ]] && parts+=("Herald OS")
  [[ $pending_pkgs -gt 0 ]] && parts+=("$(plural "$pending_pkgs" package)")
  [[ $pending_flatpaks -gt 0 ]] && parts+=("$(plural "$pending_flatpaks" app)")
  summary="up to date"
  if [[ ${#parts[@]} -gt 0 ]]; then
    summary="$(printf '%s, ' "${parts[@]}")"
    summary="${summary%, }"
  fi
  printf '{"channel":"%s","checkedAt":"%s","pending":%d,"shell":%d,"packages":%d,"flatpaks":%d}\n' \
    "$CHANNEL" "$(date -Is)" "$total" "$pending_repo" "$pending_pkgs" "$pending_flatpaks" >"$STATE/update-available.json"
  echo "$summary"
  report "$total" "$summary"
  exit 0
fi

# ---------------------------------------------------------------------------------------------
echo "==> Herald OS update ($CHANNEL)"
notify "Updating Herald OS" "This can take a few minutes."

if [[ -n "$repo_remote" && $pending_repo -gt 0 ]]; then
  echo "==> shell: pulling $repo_remote"
  git -C "$REPO" pull --ff-only --quiet origin "$(branch_for_channel)" || failed+=(shell)
fi

run_migrations

if [[ $SYSTEM -eq 1 ]]; then
  echo "==> packages"
  sudo -n dnf -y -q upgrade || failed+=(packages)
  if command -v flatpak >/dev/null; then
    echo "==> flatpaks"
    flatpak update -y --noninteractive --user >/dev/null || failed+=(flatpaks)
  fi
fi

if [[ $HERMES -eq 1 ]]; then
  hermes_bin="$HOME/.hermes/hermes-agent/venv/bin/hermes"
  if [[ -x "$hermes_bin" ]]; then
    echo "==> Hermes Agent"
    "$hermes_bin" update </dev/null >/dev/null 2>&1 || echo "WARNING: hermes update did not complete (run it in a terminal)"
  fi
fi

if [[ -x "$REPO/linux/dev/build.sh" && ( $pending_repo -gt 0 || -n "${HERALD_OS_FORCE_REBUILD:-}" ) ]]; then
  echo "==> rebuilding the shell"
  bash "$REPO/linux/dev/build.sh" || failed+=(build)
fi

printf '{"channel":"%s","checkedAt":"%s","pending":0,"shell":0,"packages":0,"flatpaks":0}\n' "$CHANNEL" "$(date -Is)" >"$STATE/update-available.json"
report 0 "up to date"

# Hooks in ~/.config/herald-os/hooks/after-update.d/ and "after Herald OS updates" automations.
if command -v herald-os >/dev/null; then
  herald-os event after-update "problems=${failed[*]:-none}" >/dev/null 2>&1 || true
fi

if [[ ${#failed[@]} -gt 0 ]]; then
  notify "Update finished with problems" "${failed[*]}"
  echo "failed: ${failed[*]}" >&2
  exit 1
fi
notify "Herald OS is up to date" "Restart the shell to use the new build."
if [[ $pending_repo -gt 0 ]]; then
  herald-os-restart-shell >/dev/null 2>&1 || true
fi
