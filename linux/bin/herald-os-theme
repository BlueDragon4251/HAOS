#!/usr/bin/env python3
"""Herald OS theme engine.

One theme definition (linux/themes/<name>/theme.json) recolours the whole system at once: the
shell (theme + accent preference), niri (borders, backdrop), swaylock, GTK 3/4 apps, the foot
rescue terminal, and the wallpaper. Each generated file is replaced before the shell is told,
and previous files are restored on a caught error. This is not a crash-safe whole-session swap.

  herald-os-theme list | current | current-revision | set <name> [--revision <sha256>] | show <name>
"""

from __future__ import annotations

import json
import hashlib
import os
import re
import shutil
import socket
import stat
import subprocess
import sys
import runpy
from pathlib import Path

HOME = Path.home()
CONFIG = HOME / ".config"
STATE = HOME / ".config" / "herald-os"
# The themes that came with this command come first: a checkout's linux/themes, or the app's
# resources/themes when the command is a link into it (/opt/herald-os: the Arch package, the release
# tarball). Copies installed elsewhere (the image, the development VM) use the folders after them.
_SOURCE = Path(__file__).resolve().parent.parent
THEME_DIRS = [
    *([Path(os.environ["HERALD_OS_THEMES"])] if os.environ.get("HERALD_OS_THEMES") else []),
    (_SOURCE.parent if _SOURCE.name == "herald-os-linux" else _SOURCE) / "themes",
    HOME / "Herald-OS" / "linux" / "themes",
    Path("/usr/local/share/herald-os-linux/themes"),
    Path("/usr/share/herald-os/themes"),
    Path("/opt/herald-os/resources/themes"),
    STATE / "themes",
]
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}")
SOCKET = RUNTIME / "herald-os" / "control.sock"
DEFAULT = "herald-ocean"
NAME = re.compile(r"^[a-z0-9][a-z0-9-]{0,39}$")
REVISION = re.compile(r"^[a-f0-9]{64}$")
COLOR = re.compile(r"^#[0-9a-fA-F]{6}$")
COLOR_KEYS = {"bg", "bg2", "surface", "fg", "fg_dim", "accent", "accent_strong", "border_active", "border_inactive", "urgent", "ok", "warn"}


def validate(theme: dict) -> None:
    """Match the native data schema before rendering KDL/CSS/INI or opening assets."""
    if not isinstance(theme, dict) or set(theme) - {"name", "label", "description", "shell", "wallpaper", "colors", "gtk", "terminal"}:
        raise ValueError("unsupported theme fields")
    if not isinstance(theme.get("name"), str) or not NAME.fullmatch(theme["name"]):
        raise ValueError("invalid theme name")
    colors = theme.get("colors")
    if not isinstance(colors, dict) or set(colors) != COLOR_KEYS or any(not isinstance(v, str) or not COLOR.fullmatch(v) for v in colors.values()):
        raise ValueError("theme colors must be #rrggbb")
    for field, limit in (("label", 128), ("description", 2048)):
        if field in theme and (not isinstance(theme[field], str) or len(theme[field]) > limit or re.search(r"[\x00-\x1f\x7f-\x9f]", theme[field])):
            raise ValueError("invalid theme text")
    wallpaper = theme.get("wallpaper", "default")
    if not isinstance(wallpaper, str) or (wallpaper != "default" and not re.fullmatch(r"[a-z0-9][a-z0-9._-]{0,127}\.(png|jpe?g|webp|avif)", wallpaper, re.I)):
        raise ValueError("wallpaper must be a local raster image basename")
    for field, allowed in (("shell", {"theme", "accent", "scheme"}), ("gtk", {"color_scheme", "theme"}), ("terminal", {"background", "foreground", "cursor", "palette"})):
        section = theme.get(field, {})
        if not isinstance(section, dict) or set(section) - allowed:
            raise ValueError(f"invalid theme {field}")
    shell = theme.get("shell", {})
    for field, allowed in (("theme", {"ocean", "graphite"}), ("accent", {"blue", "ice", "violet"}), ("scheme", {"dark", "light"})):
        if field in shell and (not isinstance(shell[field], str) or shell[field] not in allowed):
            raise ValueError("invalid shell preset")
    gtk = theme.get("gtk", {})
    if "color_scheme" in gtk and gtk["color_scheme"] not in ("default", "prefer-dark", "prefer-light"):
        raise ValueError("invalid GTK scheme")
    if "theme" in gtk and (not isinstance(gtk["theme"], str) or not re.fullmatch(r"[a-z0-9][a-z0-9 ._-]{0,127}", gtk["theme"], re.I)):
        raise ValueError("invalid GTK theme")
    terminal = theme.get("terminal", {})
    for field in ("background", "foreground", "cursor"):
        if field in terminal and (not isinstance(terminal[field], str) or not COLOR.fullmatch(terminal[field])):
            raise ValueError("invalid terminal color")
    if "palette" in terminal and (not isinstance(terminal["palette"], list) or len(terminal["palette"]) != 16 or any(not isinstance(v, str) or not COLOR.fullmatch(v) for v in terminal["palette"])):
        raise ValueError("terminal palette must contain 16 hex colors")


def read_spec(directory: Path) -> dict:
    if directory.is_symlink() or not NAME.fullmatch(directory.name):
        raise ValueError("invalid theme directory")
    fd = os.open(directory / "theme.json", os.O_RDONLY | os.O_NOFOLLOW)
    try:
        metadata = os.fstat(fd)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_size > 65536:
            raise ValueError("theme.json must be a bounded regular file")
        with os.fdopen(fd) as stream:
            fd = -1
            theme = json.load(stream)
    finally:
        if fd >= 0:
            os.close(fd)
    validate(theme)
    if theme["name"] != directory.name:
        raise ValueError("theme name does not match directory")
    wallpaper = theme.get("wallpaper", "default")
    if wallpaper != "default":
        asset = (directory / wallpaper).lstat()
        if not stat.S_ISREG(asset.st_mode) or asset.st_size > 25 * 1024 * 1024:
            raise ValueError("wallpaper must be a bounded regular file, not a symlink")
    return theme


def die(message: str, code: int = 1) -> None:
    print(f"herald-os-theme: {message}", file=sys.stderr)
    sys.exit(code)


def revision_theme(name: str, revision: str | None = None) -> tuple[Path, dict]:
    """Read the same complete, checksum-verified bundle as the native shell."""
    if not NAME.fullmatch(name):
        raise ValueError("invalid theme name")
    base = STATE / "theme-versions" / name
    for parent in (HOME, CONFIG, STATE, base.parent, base):
        info = parent.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_mode & 0o022:
            raise ValueError("unsafe theme bundle directory")

    def bounded(file: Path, limit: int) -> bytes:
        fd = os.open(file, os.O_RDONLY | os.O_NOFOLLOW)
        try:
            info = os.fstat(fd)
            if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_size > limit:
                raise ValueError("unsafe theme bundle file")
            with os.fdopen(fd, "rb") as stream:
                fd = -1
                data = stream.read(limit + 1)
            if len(data) != info.st_size:
                raise ValueError("theme bundle file changed")
            return data
        finally:
            if fd >= 0:
                os.close(fd)

    if revision is None:
        index = json.loads(bounded(base / "current.json", 1024))
        if not isinstance(index, dict) or set(index) != {"schema", "revision"} or type(index["schema"]) is not int or index["schema"] != 1:
            raise ValueError("invalid theme revision index")
        revision = index["revision"]
    if not isinstance(revision, str) or not REVISION.fullmatch(revision):
        raise ValueError("invalid theme revision")
    directory = base / revision
    info = directory.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_mode & 0o022:
        raise ValueError("unsafe theme revision directory")
    manifest = bounded(directory / "theme.json", 65536)
    theme = json.loads(manifest)
    validate(theme)
    if theme["name"] != name:
        raise ValueError("theme revision identity changed")
    wallpaper = theme.get("wallpaper", "default")
    image = bounded(directory / wallpaper, 25 * 1024 * 1024) if wallpaper != "default" else b""
    if hashlib.sha256(manifest + b"\0" + image).hexdigest() != revision:
        raise ValueError("theme revision failed its checksum")
    return directory, theme


def find(name: str, revision: str | None = None) -> tuple[Path, dict] | None:
    if not NAME.fullmatch(name):
        return None
    if revision is not None:
        return revision_theme(name, revision)
    for base in THEME_DIRS:
        if base == STATE / "themes" and (STATE / "theme-versions" / name).exists():
            return revision_theme(name)
        if not base or not base.is_dir():
            continue
        candidate = base / name / "theme.json"
        if candidate.exists():
            try:
                return candidate.parent, read_spec(candidate.parent)
            except (OSError, ValueError):
                return None
    if (STATE / "theme-versions" / name).exists():
        return revision_theme(name)
    return None


def all_themes() -> dict[str, dict]:
    found: dict[str, dict] = {}
    builtin = set()
    for base in THEME_DIRS:
        if not base or not base.is_dir():
            continue
        for entry in sorted(base.iterdir()):
            spec = entry / "theme.json"
            if entry.is_dir() and spec.exists() and entry.name not in found:
                try:
                    found[entry.name] = read_spec(entry)
                    if base != STATE / "themes":
                        builtin.add(entry.name)
                except (OSError, ValueError):
                    pass
    versions = STATE / "theme-versions"
    if versions.exists():
        for entry in sorted(versions.iterdir()):
            if entry.name in builtin:
                continue
            found.pop(entry.name, None)
            try:
                found[entry.name] = revision_theme(entry.name)[1]
            except (OSError, ValueError):
                pass
    return found


def current() -> str:
    marker = STATE / "theme"
    return marker.read_text().strip() if marker.exists() else DEFAULT


def write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text)
    tmp.replace(path)


def hexn(value: str) -> str:
    """#rrggbb -> rrggbb (swaylock wants bare hex)."""
    return value.lstrip("#")


def luminance(value: str) -> float:
    """WCAG relative luminance of #rrggbb."""
    def channel(byte: int) -> float:
        s = byte / 255
        return s / 12.92 if s <= 0.03928 else ((s + 0.055) / 1.055) ** 2.4

    raw = hexn(value)
    r, g, b = (int(raw[i:i + 2], 16) for i in (0, 2, 4))
    return 0.2126 * channel(r) + 0.7152 * channel(g) + 0.0722 * channel(b)


def on_accent(c: dict) -> str:
    """Button text on the accent: white while it keeps 3:1, else near-black (light accents)."""
    return "#ffffff" if (1.05 / (luminance(c["accent"]) + 0.05)) >= 3 else "#111318"


# ---------------------------------------------------------------------------------------------
def render_niri(c: dict) -> str:
    return f"""// Written by herald-os-theme; edit the theme instead (linux/themes/<name>/theme.json).
layout {{
    background-color "{c['bg']}"
    border {{
        active-color "{c['border_active']}"
        inactive-color "{c['border_inactive']}"
        urgent-color "{c['urgent']}"
    }}
    tab-indicator {{
        active-color "{c['border_active']}"
        inactive-color "{c['border_inactive']}"
    }}
}}
overview {{
    backdrop-color "{c['bg']}"
}}
"""


def render_swaylock(c: dict) -> str:
    return f"""# Written by herald-os-theme.
daemonize
ignore-empty-password
show-failed-attempts
indicator-radius=84
indicator-thickness=6
font=Inter
font-size=22
color={hexn(c['bg'])}
inside-color={hexn(c['bg2'])}cc
inside-clear-color={hexn(c['bg2'])}cc
inside-ver-color={hexn(c['bg2'])}cc
inside-wrong-color=3a0a1acc
ring-color={hexn(c['accent'])}
ring-clear-color={hexn(c['ok'])}
ring-ver-color={hexn(c['ok'])}
ring-wrong-color={hexn(c['urgent'])}
key-hl-color={hexn(c['ok'])}
bs-hl-color={hexn(c['urgent'])}
line-color=00000000
line-clear-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
separator-color=00000000
text-color={hexn(c['fg'])}
text-clear-color={hexn(c['fg'])}
text-ver-color={hexn(c['fg'])}
text-wrong-color={hexn(c['fg'])}
"""


def render_gtk_css(c: dict) -> str:
    return f"""/* Written by herald-os-theme. */
@define-color accent_color {c['accent']};
@define-color accent_bg_color {c['accent']};
@define-color accent_fg_color {on_accent(c)};
@define-color window_bg_color {c['bg2']};
@define-color window_fg_color {c['fg']};
@define-color view_bg_color {c['surface']};
@define-color view_fg_color {c['fg']};
@define-color headerbar_bg_color {c['bg2']};
@define-color headerbar_fg_color {c['fg']};
@define-color card_bg_color {c['surface']};
@define-color popover_bg_color {c['surface']};
@define-color dialog_bg_color {c['surface']};
@define-color destructive_bg_color {c['urgent']};
@define-color success_bg_color {c['ok']};
@define-color warning_bg_color {c['warn']};
"""


def render_foot(t: dict) -> str:
    c = t["colors"]
    term = t.get("terminal", {})
    palette = term.get("palette") or []
    # `herald-os font set <family> --mono` picks the code font; the terminal follows it.
    marker = STATE / "font-mono"
    family = marker.read_text().strip() if marker.exists() else ""
    lines = [
        "# Written by herald-os-theme.",
        "[main]",
        f"font={family or 'JetBrains Mono'}:size=11, Noto Sans Mono:size=11",
        "pad=12x12",
        "",
        "[colors]",
        "alpha=0.96",
        f"background={hexn(term.get('background', c['bg']))}",
        f"foreground={hexn(term.get('foreground', c['fg']))}",
        f"cursor={hexn(term.get('background', c['bg']))} {hexn(term.get('cursor', c['accent']))}",
    ]
    names = ["regular0", "regular1", "regular2", "regular3", "regular4", "regular5", "regular6", "regular7",
             "bright0", "bright1", "bright2", "bright3", "bright4", "bright5", "bright6", "bright7"]
    for key, colour in zip(names, palette):
        lines.append(f"{key}={hexn(colour)}")
    return "\n".join(lines) + "\n"


HERMES_SKIN = "herald-os"


def render_hermes_skin(theme: dict) -> str:
    """Hermes's own CLI and TUI skin in the theme's colours (the same mapping the shell writes)."""
    c = theme["colors"]
    label = str(theme.get("label") or theme.get("name") or "Herald OS").replace('"', "'")
    colors = {
        "banner_border": c["accent"], "banner_title": c["accent_strong"], "banner_accent": c["accent"],
        "banner_dim": c["fg_dim"], "banner_text": c["fg"], "ui_accent": c["accent"], "ui_label": c["accent_strong"],
        "ui_ok": c["ok"], "ui_error": c["urgent"], "ui_warn": c["warn"], "prompt": c["fg"], "input_rule": c["border_inactive"],
        "response_border": c["accent"], "status_bar_bg": c["bg2"], "status_bar_text": c["fg_dim"],
        "status_bar_strong": c["accent_strong"], "status_bar_dim": c["fg_dim"], "status_bar_good": c["ok"],
        "status_bar_warn": c["warn"], "status_bar_bad": c["urgent"], "status_bar_critical": c["urgent"],
        "session_label": c["accent"], "session_border": c["border_inactive"], "completion_menu_bg": c["bg2"],
        "completion_menu_current_bg": c["surface"], "selection_bg": c["surface"], "shell_dollar": c["accent"],
        "voice_status_bg": c["bg2"],
    }
    lines = [f'# Written by Herald OS from its "{label}" theme; Herald OS rewrites it when the theme changes.',
             f"name: {HERMES_SKIN}", f'description: "Herald OS: {label}"', "colors:"]
    lines += [f'  {key}: "{value}"' for key, value in colors.items()]
    return "\n".join(lines) + "\n"


def relay(payload: dict) -> bool:
    if not SOCKET.exists():
        return False
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(5)
            s.connect(str(SOCKET))
            s.sendall((json.dumps(payload) + "\n").encode())
            s.recv(4096)
        return True
    except OSError:
        return False


def gsettings(schema: str, key: str, value: str) -> None:
    if shutil.which("gsettings"):
        try:
            subprocess.run(["gsettings", "set", schema, key, value], check=False, capture_output=True, timeout=3)
        except subprocess.TimeoutExpired:
            pass  # Existing best-effort GTK synchronization must not hang the shell.


def theme_guard():
    # Installed beside this command by the existing Linux packaging rules.
    return runpy.run_path(str(Path(__file__).resolve().with_name("herald-os-theme-watchdog")))["ThemeGuard"]()


# ---------------------------------------------------------------------------------------------
def generated_outputs(theme: dict, revision: str | None, guard=None) -> dict:
    c = theme["colors"]
    config = guard.home / ".config" if guard else CONFIG
    state = config / "herald-os" if guard else STATE
    hermes_home = guard.hermes if guard else Path(os.environ.get("HERMES_HOME") or HOME / ".hermes")
    return {
        config / "niri" / "theme.kdl": render_niri(c),
        config / "swaylock" / "config": render_swaylock(c),
        config / "gtk-3.0" / "gtk.css": render_gtk_css(c),
        config / "gtk-4.0" / "gtk.css": render_gtk_css(c),
        config / "foot" / "foot.ini": render_foot(theme),
        hermes_home / "skins" / f"{HERMES_SKIN}.yaml": render_hermes_skin(theme),
        state / "theme": theme["name"] + "\n",
        state / "theme-revision": (revision or "") + "\n",
    }


def apply(name: str, revision: str | None = None, guard=None, token=None) -> int:
    found = find(name, revision)
    if not found:
        die(f"no theme named {name!r} (see `herald-os-theme list`)", 1)
    theme_dir, theme = found
    selected_revision = theme_dir.name if REVISION.fullmatch(theme_dir.name) else None
    c = theme["colors"]
    shell = theme.get("shell", {})
    gtk = theme.get("gtk", {})

    targets = generated_outputs(theme, selected_revision, guard)
    if guard is not None:
        state = guard.pending(token)
        if guard.expired(state) or state["name"] != name or state["revision"] != selected_revision:
            raise PermissionError("guarded theme identity changed or expired")
        for target, text in targets.items():
            key = next(key for key, value in guard.targets.items() if value == target)
            if hashlib.sha256(text.encode()).hexdigest() != state["files"][key]["expected"]:
                raise PermissionError("guarded theme outputs changed before activation")
            guard.write(target, text.encode())
        # Keep Dconf unchanged while pending. Its existing best-effort GTK
        # synchronization runs only after the actual shell confirms the revision.
        print("saved revision awaiting actual shell verification")
        return 0
    backups = {path: (path.read_text() if path.exists() else None) for path in targets}
    try:
        for path, text in targets.items():
            write(path, text)
        gsettings("org.gnome.desktop.interface", "color-scheme", gtk.get("color_scheme", "prefer-dark"))
        if gtk.get("theme"):
            gsettings("org.gnome.desktop.interface", "gtk-theme", gtk["theme"])
    except Exception as exc:  # noqa: BLE001 - restore whatever was written.
        for path, text in backups.items():
            if text is None:
                path.unlink(missing_ok=True)
            else:
                write(path, text)
        die(f"could not apply {name}: {exc}", 1)

    # Wallpaper: a theme may ship an image; "default" means the shell's procedural one.
    wallpaper = theme.get("wallpaper", "default")
    wallpaper_path = "" if wallpaper in ("default", "", None) else str((theme_dir / wallpaper).resolve())
    payload = {"cmd": "theme", "args": [name], "shell": shell, "wallpaper": wallpaper_path, "colors": c}
    if selected_revision:
        payload["revision"] = selected_revision
    if not relay(payload):
        print("shell not running; it will pick the theme up on next start")
    print(f"applied {theme.get('label', name)}")
    return 0


def main(argv: list[str]) -> int:
    if not argv or argv[0] in {"-h", "--help", "help"}:
        print(__doc__.strip())
        return 0
    cmd, args = argv[0], argv[1:]
    if cmd == "list":
        cur = current()
        for name, theme in all_themes().items():
            mark = "*" if name == cur else " "
            print(f"{mark} {name:<18} {theme.get('label', '')}  {theme.get('description', '')}")
        return 0
    if cmd == "current":
        print(current())
        return 0
    if cmd == "current-revision":
        marker = STATE / "theme-revision"
        revision = marker.read_text().strip() if marker.exists() else ""
        if revision and not REVISION.fullmatch(revision):
            die("invalid current theme revision", 1)
        print(revision)
        return 0
    if cmd == "show":
        found = find(args[0]) if args else None
        if not found:
            die("show <name>", 2)
        print(json.dumps(found[1], indent=2))
        return 0
    if cmd == "set":
        if len(args) not in (1, 3) or (len(args) == 3 and args[1] != "--revision"):
            die("set <name> [--revision <sha256>]", 2)
        # A normal CLI operation must not trample a pending guarded activation.
        if (STATE / "theme-activation").exists():
            guard = theme_guard()
            with guard.lock():
                state = guard.load()
                if state and state["status"] in {"pending", "rollback_conflict"}:
                    raise PermissionError("recover the pending theme activation first")
                return apply(args[0], args[2] if len(args) == 3 else None)
        return apply(args[0], args[2] if len(args) == 3 else None)
    if cmd == "guarded-set":
        if len(args) != 5 or args[1] != "--revision" or args[3] != "--parent" or not args[4].isdigit():
            die("guarded-set <name> --revision <sha256> --parent <shell-pid>", 2)
        found = find(args[0], args[2])
        if not found or found[0].name != args[2]:
            raise ValueError("an exact verified saved revision is required")
        guard = theme_guard()
        token = guard.begin(args[0], args[2], int(args[4]), generated_outputs(found[1], args[2], guard))
        with guard.lock():
            apply(args[0], args[2], guard, token)
        print(json.dumps({"theme_guard": token, "pending": True}))
        return 0
    if cmd == "confirm":
        if len(args) != 1:
            die("confirm <theme-guard-id>", 2)
        guard = theme_guard()
        state = guard.pending(args[0])
        found = find(state["name"], state["revision"])
        if not found:
            raise ValueError("confirmed revision became unavailable")
        guard.commit(args[0])
        gtk = found[1].get("gtk", {})
        gsettings("org.gnome.desktop.interface", "color-scheme", gtk.get("color_scheme", "prefer-dark"))
        if gtk.get("theme"):
            gsettings("org.gnome.desktop.interface", "gtk-theme", gtk["theme"])
        return 0
    if cmd == "recover":
        if args:
            die("recover", 2)
        if not (STATE / "theme-activation").exists():
            return 0
        theme_guard().recover()
        return 0
    die(f"unknown command {cmd!r}", 2)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
