g haos-ui -
u haos-agent - "HAOS isolated agent" /var/lib/haos-agent /usr/sbin/nologin
u haos-control - "HAOS mission controller" /var/lib/haos-control /usr/sbin/nologin
u haos-gateway - "HAOS authenticated gateway transports" /var/lib/haos-gateway /usr/sbin/nologin
u haos-provider - "HAOS protected provider credentials" /var/lib/haos-provider /usr/sbin/nologin
u haos-provider-acp - "HAOS isolated ACP subprocess" /var/lib/haos-provider-acp /usr/sbin/nologin
u haos-viewer - "HAOS authenticated remote observation" /var/lib/haos-viewer /usr/sbin/nologin
u haos-speech - "HAOS isolated local speech decoding" /var/lib/haos-speech /usr/sbin/nologin
