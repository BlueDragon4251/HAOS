[Unit]
Description=HAOS graphical administrator setup (isolated local VT8; experimental)
After=systemd-user-sessions.service herald-os-firstboot.service
Requires=herald-os-firstboot.service
Conflicts=getty@tty8.service
Before=greetd.service
ConditionPathExists=/etc/haos/enabled

[Service]
Type=simple
ExecCondition=/usr/bin/haos-setup-gate prompt
ExecStart=/usr/bin/bash /usr/lib/haos/setup-display.sh
Restart=no
StandardInput=tty-force
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty8
TTYReset=yes
TTYVHangup=yes
UMask=0077
RuntimeDirectory=haos-setup-display
RuntimeDirectoryMode=0700
Environment=HOME=/root
Environment=LANG=C.UTF-8
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
# Only one local native UI with a private cookie, no shared normal desktop.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=96
MemoryMax=2G

# With incomplete owner/recovery, normal greetd is suppressed and this
# isolated local setup starts instead; already enrolled systems bypass it.
[Install]
WantedBy=graphical.target
