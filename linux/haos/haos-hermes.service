[Unit]
Description=HAOS isolated upstream Hermes core
Requires=haos-policy.service haos-owner-ready.service
BindsTo=haos-network.service
After=haos-network.service haos-policy.service haos-owner-ready.service network-online.target herald-os-firstboot.service
Wants=network-online.target
ConditionPathExists=/etc/haos/enabled
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=haos-agent
Group=haos-agent
WorkingDirectory=/usr/lib/haos
Environment=PYTHONDONTWRITEBYTECODE=1
LoadCredential=backend-token:/etc/haos/backend-token
LoadCredential=provider-token:/etc/haos/provider-token
ExecStart=/usr/bin/python3 -m haos.sandbox
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=30
StateDirectory=haos-agent haos-workspace
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/run/haos-volumes
ProtectHome=yes
# Pre-masking /proc/sys prevents an unprivileged PID namespace from mounting
# its procfs. Bubblewrap mounts its own read-only /proc; /sys is not exposed.
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
TasksMax=512
MemoryHigh=4G
MemoryMax=8G

[Install]
WantedBy=multi-user.target
