#!/usr/bin/env bash
# Runs inside the compositor. Publishes the Wayland environment to systemd/D-Bus (so portals and
# PipeWire find the display), then keeps the Hermes OS shell running: a crash restarts it, a clean
# exit ends the session (greetd starts a fresh one).
set -u

export ELECTRON_OZONE_PLATFORM_HINT=wayland
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM=wayland
export GDK_BACKEND=wayland,x11
export HERMES_OS_LINUX_SESSION=1
# desktop (cage): the shell is one fullscreen kiosk window. panels (niri): menu bar, dock and the
# Hermes window are separate windows the compositor places; HERMES_OS_KIOSK stays off.
export HERMES_OS_SHELL_MODE="${HERMES_OS_SHELL_MODE:-desktop}"
if [[ "$HERMES_OS_SHELL_MODE" == "desktop" ]]; then
  export HERMES_OS_KIOSK=1
fi

# Apps launched through D-Bus activation (gio launch, portals) inherit the systemd/D-Bus activation
# environment, not ours: publish the Wayland and toolkit variables there too.
export MOZ_GTK_TITLEBAR_DECORATION=system
export GTK_CSD=0
SESSION_VARS=(WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP ELECTRON_OZONE_PLATFORM_HINT MOZ_ENABLE_WAYLAND MOZ_GTK_TITLEBAR_DECORATION GTK_CSD QT_QPA_PLATFORM GDK_BACKEND)
systemctl --user import-environment "${SESSION_VARS[@]}" 2>/dev/null || true
dbus-update-activation-environment --systemd "${SESSION_VARS[@]}" 2>/dev/null || true
systemctl --user start pipewire.socket pipewire-pulse.socket wireplumber.service 2>/dev/null || true
systemctl --user start xdg-desktop-portal.service 2>/dev/null || true

APP="${HERMES_OS_APP:-$HOME/Hermes-OS/apps/os}"
# npm workspaces hoist Electron to the repo root; a standalone checkout keeps it under apps/os.
ELECTRON="${HERMES_OS_ELECTRON:-}"
if [[ -z "$ELECTRON" ]]; then
  for candidate in "$APP/node_modules/.bin/electron" "$APP/../../node_modules/.bin/electron"; do
    if [[ -x "$candidate" ]]; then
      ELECTRON="$candidate"
      break
    fi
  done
fi
LOG_DIR="$HOME/.local/state/hermes-os"
mkdir -p "$LOG_DIR"

# app-id niri window rules match on; Wayland explicitly (a stray DISPLAY would send Chromium to X11).
unset DISPLAY
flags=(--class=hermes-os --ozone-platform=wayland)
if [[ -n "${HERMES_OS_SOFTWARE_GPU:-}" ]]; then
  flags+=(--disable-gpu)
fi
# HiDPI under cage: the output is scale 1, so the shell zooms its page instead (HERMES_OS_ZOOM is
# read by Electron main; forcing Chromium's device scale factor breaks Wayland buffer sizing).
# Under niri the output scale in local.kdl handles it and the compositor script unsets the zoom.
if [[ -n "${HERMES_OS_SCALE:-}" && "$HERMES_OS_SHELL_MODE" == "desktop" ]]; then
  export HERMES_OS_ZOOM="${HERMES_OS_SCALE}"
fi
if [[ -n "${HERMES_OS_NO_SANDBOX:-}" ]]; then
  flags+=(--no-sandbox)
fi
if [[ -n "${HERMES_OS_REMOTE_DEBUG_PORT:-}" ]]; then
  flags+=("--remote-debugging-port=${HERMES_OS_REMOTE_DEBUG_PORT}")
fi

if [[ ! -x "$ELECTRON" || ! -f "$APP/dist/electron/main.mjs" && -z "${HERMES_OS_DEV_SERVER:-}" ]]; then
  # Nothing to run yet: show a plain message instead of a black screen and wait for a build.
  echo "Hermes OS shell not built at $APP. Push the repo from the Mac (linux/dev/push.sh)." >&2
  if command -v foot >/dev/null 2>&1; then
    exec foot -e bash -c 'echo "Hermes OS shell is not built yet. Run linux/dev/push.sh from the Mac."; exec bash'
  fi
  sleep 30
  exit 1
fi

failures=0
window_start=$(date +%s)
while :; do
  "$ELECTRON" "$APP" "${flags[@]}" >>"$LOG_DIR/shell.log" 2>&1
  code=$?
  if [[ $code -eq 0 ]]; then
    exit 0
  fi
  now=$(date +%s)
  if (( now - window_start > 60 )); then
    failures=0
    window_start=$now
  fi
  failures=$((failures + 1))
  echo "$(date -Is) shell exited with $code (failure $failures/5)" >>"$LOG_DIR/shell.log"
  if (( failures >= 5 )); then
    exit 1
  fi
  sleep 1
done
