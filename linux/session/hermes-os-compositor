#!/usr/bin/env bash
# Entry point greetd runs as the session user: start the Stage 1 compositor (cage) with the
# Hermes OS shell as its only client. Picks a software renderer when the VM has no GPU render node.
set -u

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=HermesOS
export XDG_SESSION_DESKTOP=hermes-os

if ! ls /dev/dri/renderD* >/dev/null 2>&1; then
  export WLR_RENDERER=pixman
  export HERMES_OS_SOFTWARE_GPU=1
fi

# Optional per-machine overrides (dev server URL, extra flags). Sourced before the shell starts.
if [[ -f "$HOME/.config/hermes-os/session.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$HOME/.config/hermes-os/session.env"
  set +a
fi

exec cage -s -- /usr/local/bin/hermes-os-session
