#!/usr/bin/env bash
# Entry point greetd runs as the session user: start the compositor with the Hermes OS shell.
#
#   HERMES_OS_COMPOSITOR=niri (default)  niri manages every window; the shell runs as panels.
#   HERMES_OS_COMPOSITOR=cage            Stage 1 kiosk: the shell is the only client.
set -u

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=HermesOS
export XDG_SESSION_DESKTOP=hermes-os

if ! ls /dev/dri/renderD* >/dev/null 2>&1; then
  export WLR_RENDERER=pixman
  export HERMES_OS_SOFTWARE_GPU=1
fi

# Optional per-machine overrides (compositor choice, output scale, dev server URL, extra flags).
if [[ -f "$HOME/.config/hermes-os/session.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$HOME/.config/hermes-os/session.env"
  set +a
fi

COMPOSITOR="${HERMES_OS_COMPOSITOR:-niri}"

# The compositor's own output is the only record of DRM/GPU/seat problems; keep the last run.
LOG_DIR="$HOME/.local/state/hermes-os"
mkdir -p "$LOG_DIR"
exec >>"$LOG_DIR/compositor.log" 2>&1
echo "$(date -Is) starting $COMPOSITOR (renderer=${WLR_RENDERER:-gpu})"

if [[ "$COMPOSITOR" == "cage" ]] || ! command -v niri >/dev/null 2>&1; then
  export HERMES_OS_SHELL_MODE=desktop
  exec cage -s -- /usr/local/bin/hermes-os-session
fi

export HERMES_OS_SHELL_MODE=panels

# Machine-specific niri settings live in local.kdl (included last by the managed config).
# HERMES_OS_SCALE applies to every connected output (and to the "winit" output used when niri is
# nested, below); the file is only written when it is missing so hand edits survive.
mkdir -p "$HOME/.config/niri"
if [[ ! -f "$HOME/.config/niri/local.kdl" ]]; then
  {
    echo "// Machine-specific niri overrides. Hermes OS never overwrites this file."
    if [[ -n "${HERMES_OS_SCALE:-}" ]]; then
      for status in /sys/class/drm/card*-*/status; do
        [[ "$(cat "$status" 2>/dev/null)" == "connected" ]] || continue
        name="$(basename "$(dirname "$status")")"
        name="${name#card*-}"
        printf 'output "%s" {\n    scale %s\n}\n' "$name" "$HERMES_OS_SCALE"
      done
      printf 'output "winit" {\n    scale %s\n}\n' "$HERMES_OS_SCALE"
    fi
  } >"$HOME/.config/niri/local.kdl"
fi

# theme.kdl is included by the managed config; make sure the active theme has written it.
if [[ ! -f "$HOME/.config/niri/theme.kdl" ]] && command -v hermes-os-theme >/dev/null; then
  hermes-os-theme set "$(hermes-os-theme current)" >/dev/null 2>&1 || echo "// theme pending" >"$HOME/.config/niri/theme.kdl"
fi
[[ -f "$HOME/.config/niri/theme.kdl" ]] || echo "// theme pending" >"$HOME/.config/niri/theme.kdl"

# The shell scales through the compositor under niri; do not also zoom the page.
unset HERMES_OS_ZOOM

# niri drives displays through DRM and refuses software GL. A VM without 3D acceleration
# (virtio-gpu reporting `-virgl`, as in QEMU/Apple Virtualization without virgl) therefore gets no
# output at all. There, nest niri's windowed backend inside cage: cage owns the display with
# software rendering, niri runs fullscreen inside it and still manages every window.
# HERMES_OS_NIRI_NESTED=0|1 forces either way.
nested="${HERMES_OS_NIRI_NESTED:-auto}"
if [[ "$nested" == "auto" ]]; then
  nested=0
  if [[ -n "${WLR_RENDERER:-}" ]]; then
    nested=1
  elif journalctl -k -b --no-pager -o cat 2>/dev/null | grep -q 'features:.*-virgl'; then
    nested=1
  fi
fi

if [[ "$nested" == "1" ]]; then
  echo "no hardware GL: nesting niri (windowed) inside cage"
  exec cage -s -- /usr/local/bin/hermes-os-niri-nested
fi

exec niri --session --config "$HOME/.config/niri/config.kdl"
